# Wavium Backend Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Modal (Serverless GPU for voice cloning)
# Get tokens at: https://modal.com/settings
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Set after running: modal deploy backend/modal_tts/app.py
MODAL_ENDPOINT_URL=
