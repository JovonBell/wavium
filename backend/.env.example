# Wavium Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
# Get URL from: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Optional: Only needed for server-side Supabase calls
SUPABASE_ANON_KEY=your-anon-key-here

# Groq API Configuration
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# CORS Configuration (optional)
# Comma-separated list of allowed origins
# Default: http://localhost:8081,http://localhost:19006
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://your-app.com
