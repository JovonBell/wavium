# WAVIUM Backend Environment Variables

# Environment
ENVIRONMENT=development

# Groq (LLM for affirmation generation)
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=

# Supabase (Database + Auth)
# Get your keys at: https://supabase.com/
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare R2 (Audio file storage)
# Set up at: https://dash.cloudflare.com/
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=wavium-audio
R2_PUBLIC_URL=

# Audio settings
AUDIO_TEMP_DIR=/tmp/wavium
MAX_DURATION_MINUTES=60
DEFAULT_SAMPLE_RATE=44100

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Modal (Serverless GPU for voice cloning)
# Get tokens at: https://modal.com/settings
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Set after running: modal deploy backend/modal_tts/app.py
MODAL_ENDPOINT_URL=
